    "zip": "wxt zip",
    "site-assets": "node scripts/make-site-assets.cjs"
  },
  "dependencies": {
    "axe-core": "4.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "jsdom": "^29.1.1",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wxt": "^0.21.5"
  }
}
